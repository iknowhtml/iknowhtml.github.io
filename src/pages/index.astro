    font-weight: bold;
    font-style: normal;
  }

  :root {
    --text-shadow-color: rgba(114, 117, 120, 0.1);
  }

  /* Glitch effect animation */
  @keyframes glitch {
    0%,
    100% {
      clip-path: inset(0 0 100% 0);
      transform: translate(0);
    }
    10% {
      clip-path: inset(80% 0 10% 0);
      transform: translate(-2px, 2px);
    }
    20% {
      clip-path: inset(20% 0 60% 0);
      transform: translate(2px, -2px);
    }
    30% {
      clip-path: inset(50% 0 30% 0);
      transform: translate(-1px, 1px);
    }
    40% {
      clip-path: inset(10% 0 80% 0);
      transform: translate(1px, -1px);
    }
    50% {
      clip-path: inset(40% 0 40% 0);
      transform: translate(-2px, 0);
    }
    60% {
      clip-path: inset(70% 0 20% 0);
      transform: translate(0, 2px);
    }
    70% {
      clip-path: inset(30% 0 50% 0);
      transform: translate(2px, 1px);
    }
    80% {
      clip-path: inset(60% 0 30% 0);
      transform: translate(-1px, -2px);
    }
    90% {
      clip-path: inset(15% 0 70% 0);
      transform: translate(1px, 0);
    }
  }

  .glitch-effect {
    position: relative;
    animation: glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  }

  .glitch-effect::before,
  .glitch-effect::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: inherit;
    background-image: inherit;
    background-size: cover;
    background-position: center;
    opacity: 0.8;
    mix-blend-mode: screen;
  }

  .glitch-effect::before {
    animation: glitch 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite reverse;
    clip-path: inset(0 0 60% 0);
    transform: translate(-2px, -1px);
    filter: hue-rotate(90deg) saturate(1.5);
  }

  .glitch-effect::after {
    animation: glitch 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    clip-path: inset(60% 0 0 0);
    transform: translate(2px, 1px);
    filter: hue-rotate(-90deg) contrast(1.2);
  }
</style>

<script>
  const video = document.querySelector("video");

  if (video) {
    const MAX_TIMEOUT_INTERVAL = 500;
    const applyRandomPlaybackRate = () => {
      setTimeout(
        () => {
          video.playbackRate = Number((5 * Math.random()).toFixed(1));
          applyRandomPlaybackRate();
        },
        Math.round(Math.random() * MAX_TIMEOUT_INTERVAL)
      );
    };

    applyRandomPlaybackRate();

    const applyRandomEffect = (effects: string[], lastRandomEffect = "") => {
      setTimeout(
        () => {
          video.className = video.className.replace(lastRandomEffect, "");

          lastRandomEffect =
            effects[Math.floor(Math.random() * effects.length)];

          if (lastRandomEffect !== "") {
            video.classList.add(lastRandomEffect);
          }

          applyRandomEffect(effects, lastRandomEffect);
        },
        Math.round(Math.random() * MAX_TIMEOUT_INTERVAL)
      );
    };

    applyRandomEffect([
      "",
      "invert",
      "grayscale",
      "scale-x-[-1]",
      "scale-y-[-1]",
    ]);
  }

  const heroContent = document.getElementById("hero-content");

  // below logic hero content is centered with video as the hero is positioned absolute
  const centerHeroContent = () => {
    if (heroContent && video) {
      const rect = video.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Calculate the amount the video is outside the viewport
      const amountOutOfView = Math.max(
        0,
        rect.top < 0 ? -rect.top : rect.bottom - viewportHeight
      );

      // Apply height to the h2 element
      heroContent.style.height = `calc(100% - ${amountOutOfView}px)`;
    }
  };

  // Update the translation when scrolling or resizing
  window.addEventListener("scroll", centerHeroContent);
  window.addEventListener("resize", centerHeroContent);
  centerHeroContent(); // Initial call to set the translation
</script>

